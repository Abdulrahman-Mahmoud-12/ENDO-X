# ==============================================================================
# ENDO-X backend configuration
# Copy this file to .env and fill in real values before running the service.
# ==============================================================================

# --- App metadata ------------------------------------------------------------
APP_NAME=ENDO-X
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# --- Server --------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend dev/prod server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Compute device ----------------------------------------------------------
# One of: auto | cpu | cuda | cuda:0
DEVICE=auto

# --- Model weights -----------------------------------------------------------
# Paths are relative to the backend working directory (or absolute).
DETECTOR_MODEL_PATH=/app/models/detector/best.pt
SEGMENTER_MODEL_PATH=/app/models/segmenter/best.pth
SEGMENTER_ENCODER_NAME=resnet34
SEGMENTER_ARCHITECTURE=unetplusplus

# --- Inference thresholds -----------------------------------------------------
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.25
SEGMENTATION_MASK_THRESHOLD=0.5
DETECTION_ROI_MARGIN=0.15

# --- Tracking ------------------------------------------------------------
TRACKER_TYPE=bytetrack

# --- Uploads / storage ---------------------------------------------------
STORAGE_ROOT=app/storage
UPLOADS_DIR=app/storage/uploads
OUTPUTS_DIR=app/storage/outputs
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=250
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov

# --- Live inference --------------------------------------------------------
LIVE_TARGET_FPS=15
